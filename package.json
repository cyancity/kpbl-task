{
  "name": "group-msg-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,server \"npm run dev -w apps/mock-gateway\" \"npm run dev -w apps/server\"",
    "build": "npm run build -w packages/shared && npm run build -w apps/mock-gateway && npm run build -w apps/server",
    "test": "npm test -w apps/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
